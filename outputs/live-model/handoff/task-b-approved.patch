+class TestConfig:
+    @pytest.fixture
+    def config_app(self):
+        app = Flask(__name__)
+        app.config.update(
+            TEST_VALUE="plain",
+            SECRET_KEY=0,
+            MY_PASSWORD=0,
+            MY_TOKEN=0,
+            API_KEY=0,
+        )
+        app.config["NESTED"] = {"INNER_SECRET": 0, "VISIBLE": 1}
+        app.config["MY_LIST"] = [{"INNER_TOKEN": 0, "VISIBLE": 1}]
+        app.config["PLAIN_OBJ"] = 1j
+        return app
+
+    @pytest.fixture
+    def config_invoke(self, config_app, runner):
+        cli = FlaskGroup(create_app=lambda: config_app)
+        return partial(runner.invoke, cli)
+
+    def test_output_masks_secrets(self, config_invoke, config_app):
+        result = config_invoke(["config"])
+        assert result.exit_code == 0
+        data = json.loads(result.output)
+        assert data["TEST_VALUE"] == "plain"
+        assert data["SECRET_KEY"] == "***"
+        assert data["MY_PASSWORD"] == "***"
+        assert data["MY_TOKEN"] == "***"
+        assert data["API_KEY"] == "***"
+        assert data["NESTED"]["INNER_SECRET"] == "***"
+        assert data["NESTED"]["VISIBLE"] == 1
+        assert data["MY_LIST"][0]["INNER_TOKEN"] == "***"
+        assert data["MY_LIST"][0]["VISIBLE"] == 1
+        assert data["PLAIN_OBJ"] == str(1j)
+        assert config_app.config["SECRET_KEY"] == 0
+        assert config_app.config["NESTED"]["INNER_SECRET"] == 0
+
+    def test_help_lists_config(self, config_invoke):
+        result = config_invoke(["--help"])
+        assert result.exit_code == 0
+        assert "config" in result.output

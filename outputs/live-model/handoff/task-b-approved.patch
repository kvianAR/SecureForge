+_sensitive_keys = ("SECRET", "PASSWORD", "TOKEN", "KEY")
+
+
+def _mask_config_value(key: str, value: t.Any) -> t.Any:
+    if any(part in key.upper() for part in _sensitive_keys):
+        return "***"
+
+    return _sanitize_config_value(value)
+
+
+def _sanitize_config_value(value: t.Any) -> t.Any:
+    if isinstance(value, dict):
+        return {k: _mask_config_value(str(k), v) for k, v in value.items()}
+
+    if isinstance(value, (list, tuple)):
+        return [_sanitize_config_value(v) for v in value]
+
+    return value
+
+
+@click.command("config", short_help="Show the config for the app.")
+@with_appcontext
+def config_command() -> None:
+    """Show the app's configuration as JSON, masking sensitive values."""
+    redacted = {
+        k: _mask_config_value(str(k), v) for k, v in current_app.config.items()
+    }
+    click.echo(
+        current_app.json.dumps(redacted, sort_keys=True, indent=2, default=str)
+    )
+
+
 cli = FlaskGroup(

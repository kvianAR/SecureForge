+class TestConfig:
+    @pytest.fixture
+    def config_app(self):
+        app = Flask(__name__)
+        app.config["SECRET_KEY"] = 0
+        app.config["MY_PASSWORD"] = 0
+        app.config["MY_TOKEN"] = 0
+        app.config["MY_API_KEY"] = 0
+        app.config["my_secret_lower"] = 0
+        app.config["PUBLIC_VALUE"] = "visible"
+        app.config["NESTED"] = {
+            "MY_SECRET": 0,
+            "ok": "visible",
+            "items": [{"MY_TOKEN": 0, "ok": "visible"}],
+        }
+        app.config["NON_SERIALIZABLE"] = frozenset({1, 2})
+        return app
+
+    @pytest.fixture
+    def invoke(self, config_app, runner):
+        cli = FlaskGroup(create_app=lambda: config_app)
+        return partial(runner.invoke, cli)
+
+    def test_masks_top_level(self, invoke, config_app):
+        result = invoke(["config"])
+        assert result.exit_code == 0
+        data = json.loads(result.output)
+        assert data["SECRET_KEY"] == "***"
+        assert data["MY_PASSWORD"] == "***"
+        assert data["MY_TOKEN"] == "***"
+        assert data["MY_API_KEY"] == "***"
+        assert data["my_secret_lower"] == "***"
+        assert data["PUBLIC_VALUE"] == "visible"
+        assert config_app.config["SECRET_KEY"] == 0
+        assert config_app.config["MY_PASSWORD"] == 0
+        assert config_app.config["MY_TOKEN"] == 0
+        assert config_app.config["MY_API_KEY"] == 0
+        assert config_app.config["my_secret_lower"] == 0
+
+    def test_nested_and_non_serializable(self, invoke, config_app):
+        result = invoke(["config"])
+        assert result.exit_code == 0
+        data = json.loads(result.output)
+        assert data["NESTED"]["MY_SECRET"] == "***"
+        assert data["NESTED"]["ok"] == "visible"
+        assert data["NESTED"]["items"][0]["MY_TOKEN"] == "***"
+        assert data["NESTED"]["items"][0]["ok"] == "visible"
+        assert isinstance(data["NON_SERIALIZABLE"], str)
+        assert config_app.config["NESTED"]["MY_SECRET"] == 0
+        assert config_app.config["NESTED"]["items"][0]["MY_TOKEN"] == 0
+
+    def test_help_lists_config(self, invoke):

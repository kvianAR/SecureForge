+def _is_sensitive_config_key(key: str) -> bool:
+    """Check if a config key looks sensitive and should be masked."""
+    upper_key = key.upper()
+    return any(
+        marker in upper_key for marker in ("SECRET", "PASSWORD", "TOKEN", "KEY")
+    )
+
+
+def _redact_config_value(value: t.Any) -> t.Any:
+    """Recursively mask sensitive values in nested mappings and sequences."""
+    if isinstance(value, dict):
+        return {
+            k: "***" if _is_sensitive_config_key(str(k)) else _redact_config_value(v)
+            for k, v in value.items()
+        }
+
+    if isinstance(value, (list, tuple)):
+        return [_redact_config_value(item) for item in value]
+
+    return value
+
+
+@click.command("config", short_help="Show the config for the app.")
+@with_appcontext
+def config_command() -> None:
+    """Show the app's configuration as JSON, masking sensitive values.
+
+    Any key containing ``SECRET``, ``PASSWORD``, ``TOKEN``, or ``KEY``
+    (case-insensitive) is shown as ``"***"``. Nested mappings and
+    sequences are redacted as well. The app's stored configuration is
+    not changed. Values that are not JSON serializable are shown as
+    strings.
+    """
+    redacted: dict[str, t.Any] = {}
+
+    for key, value in current_app.config.items():
+        if _is_sensitive_config_key(key):
+            redacted[key] = "***"
+        else:
+            redacted[key] = _redact_config_value(value)
+
+    try:
+        output = current_app.json.dumps(redacted, indent=2)
+    except TypeError:
+        output = current_app.json.dumps(redacted, indent=2, default=str)
+
+    click.echo(output)
+
+
